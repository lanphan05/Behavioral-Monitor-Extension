# PostgreSQL
POSTGRES_USER=behavioral
POSTGRES_PASSWORD=behavioral
POSTGRES_DB=behavioral_monitor
POSTGRES_PORT=5432

# API (FastAPI / Uvicorn)
# Async URL for the app (asyncpg). Alembic derives a sync psycopg URL automatically.
DATABASE_URL=postgresql+asyncpg://behavioral:behavioral@db:5432/behavioral_monitor
ARTIFACTS_DIR=/app/artifacts
BOOTSTRAP_ADMIN_TOKEN=change-me-bootstrap-admin-token

# Extension
API_BASE_URL=http://localhost:8765
